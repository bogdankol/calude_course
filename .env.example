# Signing secret for better-auth sessions/tokens. Must be 32+ chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-a-32-char-or-longer-random-string

# Base URL of the app.
BETTER_AUTH_URL=http://localhost:3000

# Path to the SQLite file (relative paths resolve from the project root).
DATABASE_PATH=data/app.db
